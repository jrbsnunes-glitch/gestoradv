# Copie para .env.test na raiz do monorepo (não commitar .env.test com segredos reais).
# Pré-requisito: Docker `pnpm docker:up` e bancos gestoradv_e2e + gestoradv_e2e_master criados
# (automático no primeiro `docker compose up` com docker/init; ou crie manualmente).

DATABASE_URL="postgresql://gestoradv:gestoradv_dev@127.0.0.1:5432/gestoradv_e2e"
MASTER_DATABASE_URL="postgresql://gestoradv:gestoradv_dev@127.0.0.1:5432/gestoradv_e2e_master"
REDIS_URL="redis://127.0.0.1:6379"
MONGODB_URI="mongodb://gestoradv:gestoradv_dev@127.0.0.1:27017/gestoradv_e2e?authSource=admin"

DEPLOYMENT_MODE="standalone"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="e2e-jwt-secret-change-me"
ADMIN_JWT_SECRET="e2e-admin-jwt-secret-change-me"

# Opcional: pular `prisma db push` no globalSetup (quando o schema já está aplicado)
# SKIP_E2E_DB_PUSH=1
