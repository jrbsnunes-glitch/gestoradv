generator client {
  provider = "prisma-client-js"
  output   = "../generated/master"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// ==================== TENANTS ====================

model Tenant {
  id            String   @id @default(cuid())
  slug          String   @unique
  cnpj          String   @unique
  razaoSocial   String   @map("razao_social")
  nomeFantasia  String?  @map("nome_fantasia")
  email         String
  telefone      String?
  databaseUrl   String   @map("database_url")
  databaseName  String   @map("database_name")
  isActive      Boolean  @default(true) @map("is_active")
  isDeleted     Boolean  @default(false) @map("is_deleted")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  license  TenantLicense?
  plan     TenantPlan?    @relation(fields: [planId], references: [id])
  planId   String?        @map("plan_id")

  @@map("tenants")
}

// ==================== LICENCAS ====================

model TenantLicense {
  id              String    @id @default(cuid())
  tenantId        String    @unique @map("tenant_id")
  chave           String    @unique
  plano           String    @default("trial")
  ativa           Boolean   @default(true)
  validade        DateTime
  ultimaValidacao DateTime? @map("ultima_validacao")
  historico       Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_licenses")
}

// ==================== PLANOS ====================

model TenantPlan {
  id               String  @id @default(cuid())
  nome             String  @unique
  descricao        String?
  maxUsuarios      Int     @default(5) @map("max_usuarios")
  maxProcessos     Int     @default(100) @map("max_processos")
  maxArmazenamento Int     @default(1024) @map("max_armazenamento")
  whatsappAtivo    Boolean @default(false) @map("whatsapp_ativo")
  iaAtiva          Boolean @default(false) @map("ia_ativa")
  precoMensal      Decimal @db.Decimal(10, 2) @map("preco_mensal")
  precoSetup       Decimal @default(0) @db.Decimal(10, 2) @map("preco_setup")
  ativo            Boolean @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("tenant_plans")
}

// ==================== ADMIN (FORNECEDOR) ====================

model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("ADMIN")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}
